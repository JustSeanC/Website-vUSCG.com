<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>vUSCG • Year at a Glance</title>

  <style>
    :root{
      --max: 1280px; /* wider */
      --radius: 16px;
      --border: rgba(255,255,255,.14);
      --muted: rgba(255,255,255,.72);
    }

    body{
      margin:0;
      font-family: system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      line-height:1.4;
      color:#fff;
      background:
        radial-gradient(900px 480px at 70% 10%, rgba(88,154,255,.10), transparent 55%),
        radial-gradient(800px 420px at 10% 0%, rgba(120,255,214,.06), transparent 55%),
        repeating-linear-gradient(0deg, rgba(255,255,255,.04), rgba(255,255,255,.04) 1px, transparent 1px, transparent 26px),
        repeating-linear-gradient(90deg, rgba(255,255,255,.03), rgba(255,255,255,.03) 1px, transparent 1px, transparent 26px),
        #0b1220;
    }

    main{ max-width:var(--max); margin:0 auto; padding:30px 16px 70px; }

    .hero{
      border-radius: calc(var(--radius) + 8px);
      border:1px solid var(--border);
      background:
        radial-gradient(1200px 380px at 10% 10%, rgba(88,154,255,.25), transparent 60%),
        radial-gradient(900px 320px at 90% 0%, rgba(120,255,214,.12), transparent 55%),
        linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
      box-shadow: 0 18px 70px rgba(0,0,0,.35);
      padding: 22px;
    }

    .topRow{ display:flex; flex-wrap:wrap; gap:10px; align-items:center; justify-content:space-between; }

    .kicker{
      display:inline-block;
      font-size:12px;
      letter-spacing:.12em;
      text-transform:uppercase;
      color:var(--muted);
      border:1px solid var(--border);
      border-radius:999px;
      padding:7px 10px;
      background: rgba(255,255,255,.03);
    }

    h1{ margin: 12px 0 6px; font-size: clamp(28px, 4vw, 44px); line-height:1.05; }
    .lead{ margin:0; color:var(--muted); max-width: 80ch; }

    .controls{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; }

    select{
      background: rgba(255,255,255,.06);
      color:#fff;
      border:1px solid rgba(255,255,255,.18);
      border-radius: 12px;
      padding: 10px 12px;
      font-weight: 800;
      outline:none;
    }

    .grid{ display:grid; grid-template-columns: repeat(12, 1fr); gap:14px; margin-top:16px; }

    .card{
      border:1px solid var(--border);
      border-radius: var(--radius);
      background: rgba(255,255,255,.04);
      box-shadow: 0 10px 28px rgba(0,0,0,.25);
      padding: 14px;
      transition: transform .18s ease, background .18s ease, border-color .18s ease;
    }
    .card:hover{
      transform: translateY(-2px);
      background: rgba(255,255,255,.055);
      border-color: rgba(255,255,255,.22);
    }

    .span-3{ grid-column: span 3; }
    .span-6{ grid-column: span 6; }
    .span-12{ grid-column: span 12; }

    .label{
      font-size:12px;
      letter-spacing:.10em;
      text-transform:uppercase;
      color:var(--muted);
    }

    .value{
      margin-top:8px;
      font-size: 34px;
      font-weight: 900;
      letter-spacing: -0.02em;
    }

    .sub{ margin-top:6px; font-size:13px; color:var(--muted); }

    .pill{
      display:inline-flex; gap:8px; align-items:center;
      border:1px solid rgba(255,255,255,.18);
      background: rgba(255,255,255,.06);
      border-radius: 999px;
      padding: 8px 10px;
      font-weight: 900;
      color:#fff;
    }
    .muted{ color: var(--muted); font-weight: 700; }

    /* Chart header row */
    .chartHead{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      flex-wrap:wrap;
    }
    .chartSelect{
      padding: 8px 10px;
      border-radius: 12px;
      font-weight: 900;
    }

    /* Airframe bars */
    .barRow{
      display:grid;
      grid-template-columns: 90px 1fr 70px;
      gap:10px;
      align-items:center;
      margin-top:10px;
    }
    .barLabel{ font-weight: 900; font-size: 14px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .barWrap{
      position:relative;
      height: 12px;
      border-radius:999px;
      background: rgba(255,255,255,.08);
      overflow:hidden;
      border: 1px solid rgba(255,255,255,.10);
    }
    .barFill{
      position:absolute; inset:0 auto 0 0;
      width: 0%;
      border-radius:999px;
      background: linear-gradient(90deg, rgba(88,154,255,.9), rgba(120,255,214,.8));
    }
    .barValue{ text-align:right; font-variant-numeric: tabular-nums; color: var(--muted); }

    /* Landing rate list rows */
    .lrRow{
      display:grid;
      grid-template-columns: 92px 1fr 120px;
      gap:10px;
      align-items:center;
      padding:8px 0;
      border-bottom: 1px solid rgba(255,255,255,.10);
    }
    .lrRow:last-child{ border-bottom:none; }
    .lrPilot{ font-weight: 900; }
    .lrName{ color: rgba(255,255,255,.75); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .lrRate{ text-align:right; font-variant-numeric: tabular-nums; font-weight: 900; }
    .lrRate.good{ color: rgba(120,255,214,.90); }
    .lrRate.bad{ color: rgba(255,140,140,.90); }

    @media (max-width: 900px){
      .span-3, .span-6{ grid-column: span 12; }
      .barRow{ grid-template-columns: 1fr; }
      .barValue{ text-align:left; }
      .lrRow{ grid-template-columns: 1fr; }
      .lrRate{ text-align:left; }
    }
    /* Make charts use full card width */
canvas{
  width: 100%;
  display: block;
}
  </style>
</head>

<body>
<main>
  <section class="hero">
    <div class="topRow">
      <span class="kicker" id="kicker">Year at a Glance</span>

      <div class="controls">
        <span class="pill">Live <span class="muted" id="updatedAt">—</span></span>
        <select id="yearSelect" aria-label="Select year"></select>
      </div>
    </div>

    <h1 id="title">vUSCG Stats</h1>
    <p class="lead" id="lead">Loading…</p>

    <div class="grid">
      <div class="card span-3">
        <div class="label">Pilots</div>
        <div class="value" id="pilots">—</div>
        <div class="sub">Unique pilots with completed flights</div>
      </div>

      <div class="card span-3">
        <div class="label">Flights</div>
        <div class="value" id="flights">—</div>
        <div class="sub">Completed flights in the selected year</div>
      </div>

      <div class="card span-3">
        <div class="label">Hours</div>
        <div class="value" id="hours">—</div>
        <div class="sub" id="hoursDisplay">—</div>
      </div>

      <div class="card span-3">
        <div class="label">Miles</div>
        <div class="value" id="miles">—</div>
        <div class="sub">Total distance</div>
      </div>

      <div class="card span-12">
        <div class="label">Currently Flying (Live)</div>
        <div class="value" id="currentlyFlying">—</div>
        <div class="sub">Active smartCARS/ACARS sessions in the last 5 minutes</div>
      </div>

      <div class="card span-12">
        <div class="chartHead">
          <div class="label" id="chartTitle">Flights Per Month</div>
          <select id="metricSelect" class="chartSelect" aria-label="Select chart metric">
            <option value="flights">Flights</option>
            <option value="hours">Hours</option>
            <option value="miles">Miles</option>
          </select>
        </div>
        <div class="sub" id="chartSub" style="margin-top:8px;">—</div>
        <div style="margin-top:10px;">
          <canvas id="trendChart" height="220"></canvas>
        </div>
      </div>

      <div class="card span-6">
        <div class="label">Best Landings</div>
        <div class="sub">Closest to 0 (negative allowed)</div>
        <div id="bestLandings" style="margin-top:10px;">Loading…</div>
      </div>

      <div class="card span-6">
        <div class="label">Worst Landings</div>
        <div class="sub">Most negative first; then largest positives</div>
        <div id="worstLandings" style="margin-top:10px;">Loading…</div>
      </div>

      <div class="card span-12">
        <div class="label">Top Airframes by Hours</div>
        <div id="airframes" class="sub" style="margin-top:10px;">Loading…</div>
      </div>
    </div>
  </section>
</main>

<script>
(() => {
  const $ = (id) => document.getElementById(id);

  const yearSelect = $('yearSelect');
  const metricSelect = $('metricSelect');
  const nowYear = new Date().getFullYear();

  // Populate dropdown: current year down to 2024
  const minYear = 2024;
  for (let y = nowYear; y >= minYear; y--) {
    const opt = document.createElement('option');
    opt.value = String(y);
    opt.textContent = String(y);
    yearSelect.appendChild(opt);
  }
  yearSelect.value = String(nowYear);

  const nf = new Intl.NumberFormat('en-US');
  const nf1 = new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 });

  let currentData = null;

  function setText(id, text){ $(id).textContent = text; }

  function formatFirstLastInitial(fullName) {
    const s = (fullName || '').trim();
    if (!s) return '—';
    const parts = s.split(/\s+/).filter(Boolean);
    if (parts.length === 1) return parts[0];
    const first = parts[0];
    const last = parts[parts.length - 1];
    const initial = last ? last[0].toUpperCase() : '';
    return initial ? `${first} ${initial}.` : first;
  }

  // Limit how many times one pilot can appear (default: 1 per list)
  function limitByPilot(list, limitTotal = 5, maxPerPilot = 1) {
    if (!Array.isArray(list)) return [];
    const counts = new Map();
    const out = [];
    for (const row of list) {
      const pid = row?.pilot_id ?? row?.user_id ?? row?.pilot ?? null;
      const key = pid == null ? JSON.stringify(row) : String(pid);
      const c = counts.get(key) || 0;
      if (c >= maxPerPilot) continue;
      counts.set(key, c + 1);
      out.push(row);
      if (out.length >= limitTotal) break;
    }
    return out;
  }

  function niceStep(rawMax) {
    if (rawMax <= 25) return 5;
    if (rawMax <= 60) return 10;
    if (rawMax <= 150) return 25;
    if (rawMax <= 300) return 50;
    if (rawMax <= 700) return 100;
    if (rawMax <= 1500) return 250;
    if (rawMax <= 3000) return 500;
    return 1000;
  }

  function drawLineChart(canvasId, labels, values, opts = {}) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return;

    const dpr = window.devicePixelRatio || 1;
    const cssWidth = canvas.clientWidth || canvas.parentElement.clientWidth;
    const cssHeight = canvas.height;

    canvas.width = Math.floor(cssWidth * dpr);
    canvas.height = Math.floor(cssHeight * dpr);

    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const w = cssWidth;
    const h = cssHeight;

    // padding (more room for Y labels)
    const padL = 52, padR = 14, padT = 10, padB = 32;

    const rawMax = Math.max(1, ...values);
    const step = niceStep(rawMax);
    const maxVal = Math.ceil(rawMax / step) * step;

    const x0 = padL, x1 = w - padR;
    const y0 = h - padB, y1 = padT;

    const xStep = (x1 - x0) / Math.max(1, (values.length - 1));
    const yScale = (y0 - y1) / (maxVal - 0);

    const fmtY = typeof opts.yFormatter === 'function'
      ? opts.yFormatter
      : (v) => String(v);

    ctx.clearRect(0, 0, w, h);

    // grid + y labels
    ctx.strokeStyle = 'rgba(255,255,255,.10)';
    ctx.lineWidth = 1;

    ctx.fillStyle = 'rgba(255,255,255,.65)';
    ctx.font = '12px system-ui, -apple-system, Segoe UI, Roboto, Arial';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';

    const ticks = 4; // 0, 25, 50, 75, 100%
    for (let i = 0; i <= ticks; i++) {
      const t = i / ticks;
      const y = y0 - (y0 - y1) * t;

      ctx.beginPath();
      ctx.moveTo(x0, y);
      ctx.lineTo(x1, y);
      ctx.stroke();

      const val = Math.round(maxVal * t);
      ctx.fillText(fmtY(val), x0 - 10, y);
    }

    // axis line
    ctx.strokeStyle = 'rgba(255,255,255,.12)';
    ctx.beginPath();
    ctx.moveTo(x0, y1);
    ctx.lineTo(x0, y0);
    ctx.stroke();

    // line
    ctx.strokeStyle = 'rgba(120,255,214,.85)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    values.forEach((v, i) => {
      const x = x0 + xStep * i;
      const y = y0 - (v * yScale);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // points
    ctx.fillStyle = 'rgba(88,154,255,.95)';
    values.forEach((v, i) => {
      const x = x0 + xStep * i;
      const y = y0 - (v * yScale);
      ctx.beginPath();
      ctx.arc(x, y, 3, 0, Math.PI * 2);
      ctx.fill();
    });

    // x labels — show all months when chart is wide enough
    ctx.fillStyle = 'rgba(255,255,255,.65)';
    ctx.font = '12px system-ui, -apple-system, Segoe UI, Roboto, Arial';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';

    const showAll = w >= 760;
    labels.forEach((lab, i) => {
      if (!showAll && labels.length > 8 && i % 2 === 1) return;
      const x = x0 + xStep * i;
      ctx.fillText(lab, x, h - 10);
    });
  }

  function renderAirframes(list){
    const wrap = $('airframes');
    wrap.innerHTML = '';

    if (!Array.isArray(list) || list.length === 0) {
      wrap.textContent = 'No airframe breakdown available (or schema differs).';
      return;
    }

    const max = Math.max(...list.map(x => Number(x.hours || 0)));

    list.forEach(row => {
      const airframe = row.airframe ?? '—';
      const hours = Number(row.hours || 0);

      const r = document.createElement('div');
      r.className = 'barRow';

      const l = document.createElement('div');
      l.className = 'barLabel';
      l.textContent = airframe;

      const bw = document.createElement('div');
      bw.className = 'barWrap';

      const bf = document.createElement('div');
      bf.className = 'barFill';
      bf.style.width = (max > 0 ? (hours / max * 100) : 0) + '%';
      bw.appendChild(bf);

      const v = document.createElement('div');
      v.className = 'barValue';
      v.textContent = nf1.format(hours) + 'h';

      r.appendChild(l);
      r.appendChild(bw);
      r.appendChild(v);

      wrap.appendChild(r);
    });
  }

  function renderLandingList(elId, list, mode){
    const el = $(elId);
    if (!el) return;

    el.innerHTML = '';

    if (!Array.isArray(list) || list.length === 0) {
      el.textContent = 'No data yet.';
      return;
    }

    // enforce per-pilot display limit (1 each) and top 5 max
    const limited = limitByPilot(list, 5, 1);

    limited.forEach(row => {
      const pilotNum = row.pilot_id ?? row.user_id ?? '—';
      const pilotTag = `C${pilotNum}`;
      const name = formatFirstLastInitial(row.pilot_name);
      const rate = Number(row.landing_rate);

      const r = document.createElement('div');
      r.className = 'lrRow';

      const p = document.createElement('div');
      p.className = 'lrPilot';
      p.textContent = pilotTag;

      const n = document.createElement('div');
      n.className = 'lrName';
      n.textContent = name;

      const v = document.createElement('div');
      v.className = 'lrRate ' + (mode === 'best' ? 'good' : 'bad');
      v.textContent = isFinite(rate) ? `${rate.toLocaleString()} ft/min` : '—';

      r.appendChild(p);
      r.appendChild(n);
      r.appendChild(v);

      el.appendChild(r);
    });
  }

  function metricMeta(metric){
    if (metric === 'hours') {
      return {
        title: 'Hours Per Month',
        yFormatter: (v) => v.toLocaleString(),
        value: (m) => {
          const h = Number(m?.hours);
          if (isFinite(h)) return h;
          const mins = Number(m?.minutes ?? m?.total_minutes);
          if (isFinite(mins)) return Math.round((mins / 60) * 10) / 10;
          return 0;
        },
        sub: (vals) => {
          const total = vals.reduce((a,b)=>a+b,0);
          const peak = vals.length ? Math.max(...vals) : 0;
          return `${total.toLocaleString(undefined,{maximumFractionDigits:1})} hours YTD • Peak month: ${peak.toLocaleString(undefined,{maximumFractionDigits:1})}h`;
        }
      };
    }

    if (metric === 'miles') {
      return {
        title: 'Miles Per Month',
        yFormatter: (v) => v.toLocaleString(),
        value: (m) => {
          const mi = Number(m?.miles);
          if (isFinite(mi)) return mi;
          const dist = Number(m?.distance);
          if (isFinite(dist)) return dist;
          return 0;
        },
        sub: (vals) => {
          const total = vals.reduce((a,b)=>a+b,0);
          const peak = vals.length ? Math.max(...vals) : 0;
          return `${total.toLocaleString(undefined,{maximumFractionDigits:1})} miles YTD • Peak month: ${peak.toLocaleString(undefined,{maximumFractionDigits:1})} mi`;
        }
      };
    }

    // default flights
    return {
      title: 'Flights Per Month',
      yFormatter: (v) => v.toLocaleString(),
      value: (m) => {
        const f = Number(m?.flights);
        return isFinite(f) ? f : 0;
      },
      sub: (vals) => {
        const total = vals.reduce((a,b)=>a+b,0);
        const peak = vals.length ? Math.max(...vals) : 0;
        return `${total.toLocaleString()} flights YTD • Peak month: ${peak.toLocaleString()} flights`;
      }
    };
  }

  function updateChart(){
    if (!currentData) return;

    const monthly = Array.isArray(currentData.monthly) ? currentData.monthly : [];
    const metric = metricSelect.value;

    const meta = metricMeta(metric);

    let labels = monthly.map(m => m.label ?? m.month ?? '');
    let values = monthly.map(m => meta.value(m));

    // “expanding” behavior: only show through the last month that has any value
    let last = 0;
    for (let i = 0; i < values.length; i++) {
      if (values[i] > 0) last = i;
    }
    labels = labels.slice(0, Math.max(1, last + 1));
    values = values.slice(0, Math.max(1, last + 1));

    $('chartTitle').textContent = meta.title;
    $('chartSub').textContent = meta.sub(values);

    drawLineChart('trendChart', labels, values, { yFormatter: meta.yFormatter });
  }

  async function loadYear(year){
    setText('lead', 'Loading…');
    ['pilots','flights','hours','miles','currentlyFlying'].forEach(id => setText(id,'—'));
    $('airframes').textContent = 'Loading…';
    $('bestLandings').textContent = 'Loading…';
    $('worstLandings').textContent = 'Loading…';
    $('chartSub').textContent = '—';

    const res = await fetch(`https://crew.vuscg.com/api/stats-year.php?year=${encodeURIComponent(year)}`, { cache: 'no-store' });
    const data = await res.json();

    if (!data || !data.ok) {
      setText('lead', 'Could not load stats.');
      $('airframes').textContent = '—';
      $('bestLandings').textContent = '—';
      $('worstLandings').textContent = '—';
      return;
    }

    currentData = data;

    setText('kicker', `${data.year} At a Glance`);
    setText('title', `vUSCG ${data.year} Stats`);
    setText('updatedAt', new Date(data.updated_at).toLocaleString());

    setText('pilots', nf.format(data.pilots ?? 0));
    setText('flights', nf.format(data.flights ?? 0));
    setText('hours', nf1.format(data.hours ?? 0));
    setText('miles', nf1.format(data.miles ?? 0));
    setText('hoursDisplay', data.hours_display ? `(${data.hours_display})` : '—');
    setText('currentlyFlying', nf.format(data.currently_flying ?? 0));

    setText('lead', `Year-to-date totals based on completed PIREPs in ${data.year}.`);

    // Airframes
    renderAirframes(data.top_airframes);

    // Landing lists
    renderLandingList('bestLandings', data.best_landings, 'best');
    renderLandingList('worstLandings', data.worst_landings, 'worst');

    // Chart
    updateChart();
  }

  // Events
  yearSelect.addEventListener('change', () => loadYear(yearSelect.value));
  metricSelect.addEventListener('change', () => updateChart());

  // Redraw chart on resize (debounced)
  let resizeTimer = null;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(updateChart, 120);
  });

  // Initial load
  loadYear(yearSelect.value);
})();
</script>
</body>
</html>